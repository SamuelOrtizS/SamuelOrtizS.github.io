---
interface Props {
  title: string;
  description?: string;
  image?: {
    src: string;
    alt: string;
    width?: number;
    height?: number;
  };
}

const { title, description, image } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    {# Meta SEO #}
    <title>{title}</title>
    <meta name="description" content={description ?? title} />
    
    {# Open Graph / Social Media #}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? title} />
    
    <!-- Google Fonts - Modern Sans Serif -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
      :root {
        --ieee-blue: #001746;
        --ieee-blue-light: #0060B3;
        --comsoc-blue: #003DA7;
        --black: #1F1F1F;
        --white: #FFFFFF;
        --gray-light: #F5F5F5;
      }
      
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        line-height: 1.6;
        color: var(--black);
        background-color: var(--white);
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 var(--space-md);
      }
      
      h1, h2, h3 {
        line-height: 1.2;
        margin-bottom: 1rem;
      }
      
      h1 { font-size: 2.5rem; color: var(--ieee-blue); }
      h2 { font-size: 2rem; color: var(--ieee-blue-light); }
      h3 { font-size: 1.5rem; color: var(--comsoc-blue); }
      
      a {
        color: var(--ieee-blue);
        text-decoration: underline;
      }
      
      a:hover {
        color: var(--ieee-blue-light);
      }
      
      main {
        min-height: 80vh;
        padding: 2rem 0;
      }
      
      .space-md { margin: 1rem 0; }
      .space-lg { margin: 2rem 0; }
      
      /* IEEE Brand Colors */
      .ieee-brand { color: var(--ieee-blue); }
      .comsoc-brand { color: var(--comsoc-blue); }
      
      /* Accessibility */
      :focus-visible {
        outline: 3px solid var(--ieee-blue-light);
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <header class="ieee-brand">
      <div style="max-width: 1200px; margin: 0 auto; padding: 1rem;">
        <nav aria-label="Principal">
          <a href="/" style="font-weight: 600; font-size: 1.25rem;">
            Samuel Ortiz Sarasti
          </a>
        </nav>
      </div>
    </header>
    
    <main>
      <slot />
    </main>
    
    <footer style="margin-top: 4rem; padding: 2rem 0; border-top: 1px solid #eee;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 var(--space-md);">
        <p style="color: #666; font-size: 0.875rem;">
          © {new Date().getFullYear()} Samuel Ortiz Sarasti. Todos los derechos reservados.
        </p>
      </div>
    </footer>
  </body>
</html>