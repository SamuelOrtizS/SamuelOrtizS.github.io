---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect unique tags
const allTags = Array.from(new Set(allPosts.flatMap((post) => post.data.tags)));
---

<BaseLayout
  title="Blog & Artículos | Samuel Ortiz"
  description="Reflexiones, tutoriales y guías sobre arquitectura web y desarrollo moderno."
>
  <div class="site-container pt-12 md:pt-16">
    
    <!-- Page Header -->
    <header class="reveal pb-8 mb-8 border-b border-base-800">
      <div class="flex items-center gap-2 text-xs font-mono text-primary-500 mb-2">
        <span>~/blog</span>
        <span class="text-base-600">/</span>
        <span class="text-base-400">{allPosts.length} entradas publicadas</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-medium tracking-tight text-base-100" data-i18n="blog.title">
        Blog & Artículos
      </h1>

      <p class="mt-3 text-sm text-base-300 max-w-2xl leading-relaxed" data-i18n="blog.subtitle">
        Reflexiones, tutoriales y guías sobre arquitectura web y desarrollo moderno.
      </p>

      <!-- Tag Filter Buttons -->
      <div class="reveal-stagger flex flex-wrap items-center gap-2 pt-6" id="tag-filter-container">
        <button
          type="button"
          data-tag="all"
          class="tag-btn active px-3 py-1 text-xs font-mono border border-primary-500 bg-primary-950/40 text-primary-400 transition-colors cursor-pointer"
        >
          <span data-i18n="blog.filter_all">Todos</span> ({allPosts.length})
        </button>
        {
          allTags.map((tag) => {
            const count = allPosts.filter((p) => p.data.tags.includes(tag)).length;
            return (
              <button
                type="button"
                data-tag={tag}
                class="tag-btn px-3 py-1 text-xs font-mono border border-base-800 bg-base-950 text-base-400 hover:border-base-700 hover:text-base-200 transition-colors cursor-pointer"
              >
                #{tag} ({count})
              </button>
            );
          })
        }
      </div>
    </header>

    <!-- Posts Directory List -->
    <div class="flex flex-col divide-y divide-base-800 border-y border-base-800" id="posts-list">
      {
        allPosts.map((post) => {
          const formattedDate = post.data.pubDate.toLocaleDateString('es-ES', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });

          return (
            <article
              class="post-card group py-6 flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 transition-opacity duration-300"
              data-tags={JSON.stringify(post.data.tags)}
            >
              <div class="max-w-2xl">
                <div class="flex items-center gap-3 text-xs text-base-400 font-mono mb-2">
                  <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                  <span>•</span>
                  <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="text-primary-400/90 font-mono">#{tag}</span>
                    ))}
                  </div>
                </div>

                <h2 class="text-lg sm:text-xl font-medium text-base-100 group-hover:text-primary-400 transition-colors">
                  <a href={`/blog/${post.id}`} class="no-underline text-inherit underline-ltr">
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-xs sm:text-sm text-base-300 leading-relaxed mt-2.5">
                  {post.data.description}
                </p>
              </div>

              <div class="sm:self-center shrink-0">
                <a
                  href={`/blog/${post.id}`}
                  class="inline-flex items-center gap-1.5 text-xs font-mono text-base-400 group-hover:text-primary-400 transition-colors"
                >
                  <span data-i18n="blog.read_more">Leer artículo</span>
                  <span class="transition-transform group-hover:translate-x-1">→</span>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

  </div>
</BaseLayout>

<script>
  function initBlogFilter() {
    // Interactive client-side filtering by tag
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
    const postCards = document.querySelectorAll<HTMLElement>('.post-card');

    function filterPosts(selectedTag: string) {
      buttons.forEach((btn) => {
        const isMatch = btn.getAttribute('data-tag') === selectedTag;
        if (isMatch) {
          btn.classList.add('border-primary-500', 'bg-primary-950/40', 'text-primary-400');
          btn.classList.remove('border-base-800', 'bg-base-950', 'text-base-400');
        } else {
          btn.classList.remove('border-primary-500', 'bg-primary-950/40', 'text-primary-400');
          btn.classList.add('border-base-800', 'bg-base-950', 'text-base-400');
        }
      });

      postCards.forEach((card) => {
        if (selectedTag === 'all') {
          (card as HTMLElement).style.opacity = '1';
          (card as HTMLElement).style.pointerEvents = 'auto';
          (card as HTMLElement).style.maxHeight = '';
          return;
        }
        const rawTags = card.getAttribute('data-tags');
        const tags: string[] = rawTags ? JSON.parse(rawTags) : [];
        const match = tags.includes(selectedTag);
        (card as HTMLElement).style.opacity = match ? '1' : '0.2';
        (card as HTMLElement).style.pointerEvents = match ? 'auto' : 'none';
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag') || 'all';
        filterPosts(tag);
      });
    });

    // Check URL query param ?tag=
    const urlParams = new URLSearchParams(window.location.search);
    const tagParam = urlParams.get('tag');
    if (tagParam) {
      filterPosts(tagParam);
    }
  }

  // Run on first load and after every client-side navigation
  document.addEventListener('astro:page-load', initBlogFilter);
</script>
