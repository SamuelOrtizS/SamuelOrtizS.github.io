---
import Button from './Button.astro';
---

<section class="my-12" id="newsletter">
  <div class="px-6 py-10 bg-base-950 border border-primary-500/80 text-center">
    <div class="max-w-md mx-auto">
      <span class="text-xs font-mono text-primary-500 uppercase tracking-wider block mb-1">
        // Subscribe
      </span>
      <h3 class="text-xl sm:text-2xl font-medium tracking-tight text-base-100 mb-2">
        In the know
      </h3>
      <p class="text-xs sm:text-sm text-base-300 mb-6 leading-relaxed">
        Get the best web engineering tips, performance deep dives, and architecture notes directly in your inbox.
      </p>

      <form class="flex flex-col sm:flex-row gap-2 max-w-sm mx-auto" id="newsletter-form">
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          placeholder="your.email@workstation.com"
          required
          class="w-full px-3.5 py-2 text-xs font-mono bg-base-900 border border-base-700 text-base-100 placeholder:text-base-500 focus:outline-none focus:border-primary-500 transition-colors"
        />
        <Button variant="primary" type="submit" class="text-xs shrink-0 py-2">
          <span>Subscribe</span>
        </Button>
      </form>

      <p class="text-[11px] text-base-500 mt-3 font-mono">
        Zero spam. Unsubscribe at any time with one click.
      </p>
    </div>
  </div>
</section>
